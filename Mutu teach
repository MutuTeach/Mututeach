<!DOCTYPE html>

<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Umut Şimşek — IB Manager</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">

<style>
body{
  margin:0;
  font-family:'Inter',sans-serif;
  background:#0B0F14;
  color:#EAFBF3;
  text-align:center;
}

/* HERO */
.hero{
  height:100vh;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  position:relative;
  overflow:hidden;
}

/* GLOW CORE */
.hero-core{
  position:absolute;
  width:600px;
  height:600px;
  background:radial-gradient(circle,#00FF94 0%,transparent 70%);
  filter:blur(100px);
}

/* ENERGY RING */
.hero-ring{
  position:absolute;
  width:260px;
  height:260px;
  border-radius:50%;
  border:2px solid #00FF94;
  box-shadow:0 0 60px #00FF94;
  animation:pulse 3s infinite ease-in-out;
}

@keyframes pulse{
  0%{transform:scale(.9);opacity:.6}
  50%{transform:scale(1.15);opacity:1}
  100%{transform:scale(.9);opacity:.6}
}

/* TEXT */
h1{
  font-size:56px;
  line-height:1.1;
  text-shadow:0 0 30px rgba(0,255,150,.5);
  margin-bottom:10px;
}

p{
  color:#8FA3A8;
  font-size:18px;
}

/* BUTTON */
.btn{
  margin-top:25px;
  padding:16px 36px;
  background:linear-gradient(135deg,#00FF94,#00C853);
  color:black;
  text-decoration:none;
  font-weight:700;
  border-radius:10px;
  box-shadow:0 0 30px rgba(0,255,150,.6);
  transition:.3s;
}

.btn:hover{
  box-shadow:0 0 60px rgba(0,255,150,1);
  transform:translateY(-3px);
}

/* SECTIONS */
.section{
  padding:80px 20px;
}

.card{
  background:rgba(255,255,255,.04);
  padding:30px;
  margin:10px auto;
  max-width:300px;
  border-radius:12px;
  backdrop-filter:blur(12px);
  transition:.3s;
}

.card:hover{
  transform:translateY(-5px);
  box-shadow:0 0 20px rgba(0,255,150,.2);
}

/* FOOTER */
footer{
  padding:30px;
  color:#8FA3A8;
  font-size:14px;
}
</style>

</head>

<body>

<!-- HERO -->

<section class="hero">
  <div class="hero-core"></div>
  <div class="hero-ring"></div>

  <h1>START EARNING<br>WITH FOREX</h1>
  <p>Join my private trading network</p>
  <a class="btn" href="#">JOIN NOW</a>
</section>

<!-- FEATURES -->

<section class="section">
  <h2>Why Join Me?</h2>

  <div class="card">Low spreads</div>
  <div class="card">Fast withdrawals</div>
  <div class="card">High commissions</div>
</section>

<!-- ABOUT -->

<section class="section">
  <h2>About Me</h2>
  <p>IB Manager with 6+ years experience helping traders grow globally.</p>
</section>

<!-- CTA -->

<section class="section">
  <h2>Ready to Start?</h2>
  <a class="btn" href="#">JOIN NOW</a>
</section>

<footer>
© 2025 Umut Şimşek — All Rights Reserved
</footer>

</body>
</html>
